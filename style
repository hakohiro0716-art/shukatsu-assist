/* ------------------------------
   全体スタイル（Apple風・淡い青）
------------------------------ */

:root {
  --bg: #f6f8fc;
  --card-bg: #ffffff;
  --accent: #b9d7ff;
  --accent-dark: #6daaff;
  --text: #202124;
  --text-light: #5f6368;
  --border: #dadce0;
  --radius: 12px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  margin: 0;
  padding: 0;
}

/* ------------------------------
   ヘッダー
------------------------------ */
.header {
  text-align: center;
  padding: 25px 10px 10px;
}

.header h1 {
  margin: 0;
  font-size: 26px;
  font-weight: 700;
}

.header p {
  margin: 5px 0;
  color: var(--text-light);
  font-size: 14px;
}

/* ------------------------------
   タブ
------------------------------ */
.tabs {
  display: flex;
  gap: 8px;
  justify-content: center;
  padding: 0 10px;
  margin-bottom: 15px;
  overflow-x: auto;
}

.tab {
  border: none;
  padding: 10px 14px;
  border-radius: var(--radius);
  background: #eef4ff;
  cursor: pointer;
  color: var(--text);
  transition: 0.25s;
  white-space: nowrap;
}

.tab.active {
  background: var(--accent);
  color: #000;
  font-weight: 600;
  box-shadow: 0px 2px 7px rgba(100, 150, 255, 0.25);
}

/* ------------------------------
   カード
------------------------------ */
.card {
  background: var(--card-bg);
  padding: 18px;
  margin: 0 10px 20px;
  border-radius: var(--radius);
  box-shadow: 0px 4px 12px rgba(0,0,0,0.08);
}

.card h2 {
  margin-top: 0;
  font-size: 20px;
  border-left: 4px solid var(--accent);
  padding-left: 10px;
}

label {
  display: block;
  font-size: 14px;
  margin-top: 15px;
  margin-bottom: 4px;
  color: var(--text-light);
}

select,
textarea,
input[type="text"] {
  width: 100%;
  padding: 10px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  font-size: 14px;
  transition: 0.2s;
  outline: none;
  background: white;
}

textarea {
  min-height: 70px;
  resize: vertical;
}

select:focus,
textarea:focus,
input:focus {
  border-color: var(--accent-dark);
  box-shadow: 0 0 0 3px rgba(100,150,255,0.2);
}

/* ------------------------------
   ボタン
------------------------------ */
.btn {
  background: var(--accent-dark);
  color: white;
  border: none;
  padding: 12px;
  width: 100%;
  border-radius: var(--radius);
  margin-top: 15px;
  cursor: pointer;
  font-size: 15px;
  font-weight: 600;
  transition: 0.25s;
}

.btn:hover {
  opacity: 0.9;
}

.btn.secondary {
  background: #e7ecf5;
  color: var(--text);
}

.btn.small {
  padding: 8px;
  font-size: 13px;
}

/* ------------------------------
   結果表示
------------------------------ */
.result-box {
  background: #f8f9fb;
  border: 1px solid var(--border);
  padding: 12px;
  border-radius: var(--radius);
  margin-top: 15px;
  white-space: pre-wrap;
}

.result-title {
  font-weight: 600;
  color: var(--text-light);
  font-size: 13px;
  margin-bottom: 6px;
}

/* ------------------------------
   面接官モード
------------------------------ */

#interviewLog {
  max-height: 300px;
  overflow-y: auto;
}

.interview-buttons {
  display: flex;
  gap: 10px;
}

#micBtn {
  flex: 1;
}

#sendInterviewAnswer {
  flex: 1;
}

/* ------------------------------
   PRリスト
------------------------------ */
.pr-list {
  margin-top: 15px;
}

.pr-item {
  background: #ffffff;
  border: 1px solid var(--border);
  padding: 10px;
  margin-bottom: 10px;
  border-radius: var(--radius);
}

.pr-title {
  font-size: 15px;
  font-weight: 600;
}

.pr-date {
  font-size: 12px;
  color: var(--text-light);
}
